		"@tanstack/react-query": "5.104.0",
		"@tanstack/react-router": "1.170.40",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.59",
		"@tanstack/react-virtual": "3.14.13",
		"lucide-react": "1.48.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"ulid": "3.0.2",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@clerk/backend": "3.20.1",
		"@clerk/testing": "2.2.39",
