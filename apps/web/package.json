{
	"name": "@noodle/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -p tsconfig.json",
