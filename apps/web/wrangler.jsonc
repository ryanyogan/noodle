{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noodle",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	// TanStack Start's server entry, plus the Household Agent class it exports.
	"main": "src/server.ts",
	// Logs and traces, every request, kept in Workers Observability (set by the Parent, 2026-10-03).
	// Query strings aren't redacted; the invite token is in the path (/invite/<token>) either way.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	},
	// The app's address. workers.dev stays on so links already handed out, and the webhook URLs
	// Plaid stored for Bank Connections made before the move, keep working.
	"routes": [{ "pattern": "noodle.yogan.dev", "custom_domain": true }],
	"workers_dev": true,
	"vars": {
		"CLERK_SIGN_IN_URL": "/sign-in",
		"CLERK_SIGN_UP_URL": "/sign-up",
		// The app's own address, for links in emails and the webhook URL given to Plaid.
		"APP_ORIGIN": "https://noodle.yogan.dev",
		// Who Noodle's emails come from, shown as "Noodle" (ADR-0026): invites and the Check-in.
		"EMAIL_FROM": "hello@noodle.yogan.dev",
		// Ask's model calls go through this AI Gateway (ADR-0012); "default" is auto-created on first use.
		"AI_GATEWAY_ID": "default",
		// Plaid's environment for Bank Connections: "sandbox" or "production" (ADR-0017). They also
		// need the PLAID_CLIENT_ID, PLAID_SECRET and BANK_CONNECTION_KEY secrets (server/bank-setup.ts);
		// without them the Accounts page says Plaid isn't set up. For production, set "production"
		// and replace PLAID_SECRET with the production secret.
		"PLAID_ENV": "sandbox",
		// The nightly backup (ADR-0032) calls the D1 export API for this account and database, with
		// the D1_EXPORT_TOKEN secret, and emails failures to BACKUP_ALERT_TO (a var or secret; unset,
		// failures are only logged).
		"BACKUP_ACCOUNT_ID": "8ad084035b854467eb9d93ae3363d40b",
		"BACKUP_DATABASE_ID": "dc862efc-c574-409a-a2c2-05fa98807dac"
	},
	// Workers AI, for Ask and categorization (ADR-0012). It has no local simulator: `vite dev` calls
	// the real service with the logged-in account, unless AI_MODEL=stub (as E2E runs) swaps in
	// deterministic fakes.
	"ai": { "binding": "AI", "remote": true },
	// Merchants the Household has filed, as embeddings (AI_MODELS.embed, 1024 dimensions, cosine),
	// with `householdId` metadata indexed: every query is filtered to one Household. Remote in dev
	// too (no local simulator); AI_MODEL=stub uses an in-memory fake instead.
	"vectorize": [{ "binding": "MERCHANTS", "index_name": "noodle-merchants", "remote": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "noodle",
			"database_id": "dc862efc-c574-409a-a2c2-05fa98807dac",
			"migrations_dir": "../../packages/db/drizzle"
		}
	],
	// Statement files Parents upload for their Accounts, one object per Import (ADR-0005), and each
	// forwarded Receipt's email, under receipts/ (ADR-0016).
	// Nightly D1 dumps and manifests (ADR-0032): d1/YYYY/MM/DD.sql kept 30 days, d1/monthly/ kept
	// 370, and a bucket lock on d1/ for 14 days (lifecycle and lock rules set with wrangler).
	"r2_buckets": [
		{ "binding": "STATEMENTS", "bucket_name": "noodle-statements" },
		{ "binding": "BACKUPS", "bucket_name": "noodle-backups" }
	],
	// Image transformations, for a photographed Receipt's thumbnail (ADR-0016).
	"images": { "binding": "IMAGES" },
	// One Household Agent per Household: the real-time hub both Parents' screens connect to (ADR-0007).
	"durable_objects": {
		"bindings": [{ "name": "HOUSEHOLD_AGENT", "class_name": "HouseholdAgent" }]
	},
	"exports": {
		"HouseholdAgent": { "type": "durable-object", "storage": "sqlite" }
	},
	// Nudges the Household Agent decides go out through this Queue, consumed by this Worker, which
	// sends each as Web Push. Needs VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, and VAPID_SUBJECT secrets.
	// Quick Adds the iPhone Shortcut captures at the tap (POST /api/capture) wait on the ingest
	// Queue, which this Worker also consumes, so the Shortcut gets its answer at once; so does each
	// Bank Connection to read, which the consumer hands to the Import Workflow.
	"queues": {
		"producers": [
			{ "binding": "NUDGE_QUEUE", "queue": "noodle-nudges" },
			{ "binding": "INGEST_QUEUE", "queue": "noodle-ingest" }
		],
		"consumers": [
			{ "queue": "noodle-nudges", "max_batch_size": 10, "max_retries": 3 },
			{ "queue": "noodle-ingest", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5 }
		]
	},
	// Closing each Household's month: the hourly cron on the 1st to 3rd starts one Month-close
	// Workflow per Household once its own 1st has begun; each waits up to a week for the Parents'
	// decision, then applies the defaults. Every night at 09:00 UTC (early morning across the US),
	// another cron looks for Insights in every Household, then starts the weekly Check-in wherever
	// it's Check-in day (server.ts dispatches by cron), and re-checks Perks a month old. The Perk
	// research Workflow reads a Perk Source's benefits page when a Parent confirms or adds one. The
	// Import Workflow reads a Bank Connection's Transactions, started from the ingest Queue. The Setup
	// Workflow waits for a new Household's first history, files it and drafts the Plan (#53).
	"workflows": [
		{ "name": "noodle-month-close", "binding": "MONTH_CLOSE", "class_name": "MonthCloseWorkflow" },
		{
			"name": "noodle-perk-research",
			"binding": "PERK_RESEARCH",
			"class_name": "PerkResearchWorkflow"
		},
		{ "name": "noodle-import", "binding": "IMPORT", "class_name": "ImportWorkflow" },
		{ "name": "noodle-setup", "binding": "SETUP", "class_name": "SetupWorkflow" },
		{ "name": "noodle-export", "binding": "EXPORT", "class_name": "ExportWorkflow" },
		{ "name": "noodle-fresh-start", "binding": "FRESH_START", "class_name": "FreshStartWorkflow" },
		// The nightly whole-database backup, started first by the 09:00 UTC cron (ADR-0032).
		{ "name": "noodle-backup", "binding": "BACKUP", "class_name": "BackupWorkflow" },
		// Restoring a Household snapshot (#78, ADR-0035).
		{ "name": "noodle-restore", "binding": "RESTORE", "class_name": "SnapshotRestoreWorkflow" }
	],
	"triggers": { "crons": ["0 * 1-3 * *", "0 9 * * *"] },
	// Invites to the other Parent and the Check-in's email summary go out through Cloudflare Email
	// Service (server/email/send.ts, ADR-0026), only from EMAIL_FROM. noodle.yogan.dev must be
	// onboarded to Email Sending first (`wrangler email sending enable noodle.yogan.dev`). With
	// AI_MODEL=stub nothing is sent: emails land in a dev outbox E2E reads.
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@noodle.yogan.dev"] }]
	// Forwarded Receipts arrive by Email Routing (ADR-0016): route receipts@<domain>, with
	// subaddressing on, to this Worker, and add to "vars": "RECEIPTS_EMAIL_DOMAIN": "<domain>".
	// Without it the Household page says forwarding isn't set up.
}
