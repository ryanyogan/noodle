{
	"name": "noodle",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "turbo run test",
		"e2e": "turbo run e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"turbo": "2.11.5",
		"typescript": "6.0.3"
	}
}
